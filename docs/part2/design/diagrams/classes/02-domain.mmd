classDiagram
    direction TB
    class Workout {
      +UUID id
      +UUID ownerId
      +Date workoutDate
      +WorkoutState state
      +DateTime startedAt
      +DateTime finishedAt
      +int revision
      +WorkoutEntry[] entries
      +finish()
      +validate()
    }
    class WorkoutEntry {
      +UUID id
      +UUID exerciseId
      +int position
      +ExerciseSet[] sets
    }
    class ExerciseSet {
      +UUID id
      +int position
      +Decimal enteredWeight
      +WeightUnit enteredUnit
      +int reps
      +int seconds
    }
    class Exercise {
      +UUID id
      +UUID ownerId
      +String name
      +String normalizedName
      +ExerciseType type
      +String muscleGroup
      +bool archived
      +bool everUsed
      +int revision
    }
    class Template {
      +UUID id
      +UUID ownerId
      +String name
      +TemplateEntry[] entries
      +int revision
    }
    class TemplateEntry {
      +UUID exerciseId
      +int position
    }
    class UserSettings {
      +WeightUnit preferredUnit
      +bool showEquivalent
      +Decimal textScale
      +int revision
    }
    class WorkoutService {
      +start(date)
      +addExercise(id)
      +prefill(entryId)
      +recordSet(input)
      +mutateActive(patch)
      +undo(token)
      +finish()
      +resume()
      +discard()
    }
    class ExerciseService {
      +search(text, muscle)
      +create(input)
      +rename(id, name)
      +archiveOrRestore(id)
    }
    class HistoryService {
      +list(filter, cursor)
      +getWorkout(id)
      +latestPerformance(exerciseId)
      +exerciseHistory(id)
      +editFinished(id, patch)
      +deleteWorkout(id)
    }
    class TemplateService {
      +fromWorkout(id, name)
      +save(input)
      +startWorkout(id)
      +delete(id)
    }
    class SettingsService {
      +load()
      +update(patch)
    }
    class ProgressService {
      +exerciseSeries(id, period)
      +weeklySeries(period)
      +contributingWorkouts(point)
    }
    class InputValidator {
      +validateDate(date, timezone)
      +validateTypedSet(input, exercise)
      +validateName(name)
      +normalizeName(name)
    }
    class UndoToken {
      +UUID workoutId
      +Workout priorSnapshot
      +bool available
    }
