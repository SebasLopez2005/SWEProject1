classDiagram
    direction TB
    class Workout {
      +UUID id
      +UUID ownerId
      +Date workoutDate
      +UUID sourceTemplateId
      +int sourceTemplateRevision
      +int defaultRestSeconds
      +WorkoutState state
      +DateTime startedAt
      +DateTime finishedAt
      +int revision
      +WorkoutEntry[] entries
      +finish()
      +validate()
    }
    class WorkoutEntry {
      +UUID id
      +UUID exerciseId
      +int position
      +TrainingPhase phase
      +RestRule restRule
      +ExerciseSet[] sets
    }
    class ExerciseSet {
      +UUID id
      +int position
      +SetState state
      +SetTarget targetSnapshot
      +Decimal enteredWeight
      +WeightUnit enteredUnit
      +int reps
      +int seconds
      +int actualRir
      +DateTime completedAt
    }
    class Exercise {
      +UUID id
      +UUID ownerId
      +String name
      +String normalizedName
      +ExerciseType type
      +String muscleGroup
      +MuscleRole[] muscleTags
      +bool archived
      +bool everUsed
      +int revision
    }
    class Template {
      +UUID id
      +UUID ownerId
      +String name
      +TemplateEntry[] entries
      +int defaultRestSeconds
      +int revision
    }
    class TemplateEntry {
      +UUID exerciseId
      +int position
      +TrainingPhase phase
      +int targetSetCount
      +SetTarget target
      +RestRule restRule
    }
    class SetTarget {
      +int reps
      +int seconds
      +Decimal load
      +WeightUnit unit
      +int rirMin
      +int rirMax
    }
    class TrainingPhase {
      <<enumeration>>
      warmup
      work
      mobility
    }
    class SetState {
      <<enumeration>>
      pending
      done
      skipped
    }
    class RestRule {
      +String mode
      +int seconds
    }
    class MuscleRole {
      +String regionId
      +String role
    }
    class UserSettings {
      +WeightUnit preferredUnit
      +bool showEquivalent
      +Decimal textScale
      +int revision
    }
    class WorkoutService {
      +start(date)
      +startWithSnapshot(date, routine)
      +addExercise(id)
      +prefill(entryId)
      +recordSet(input)
      +markDone(rowId, actual)
      +skip(rowId)
      +mutateActive(patch)
      +undo(token)
      +finish(confirmSkipPending)
      +resume()
      +discard()
    }
    class ExerciseService {
      +search(text, muscle, equipment, category)
      +create(input)
      +rename(id, name)
      +archiveOrRestore(id)
    }
    class HistoryService {
      +list(filter, cursor)
      +getWorkout(id)
      +latestPerformance(exerciseId)
      +exerciseHistory(id)
      +editFinished(id, patch)
      +deleteWorkout(id)
    }
    class TemplateService {
      +reviewFromWorkout(id)
      +saveReviewedRoutine(input)
      +save(input)
      +startWorkout(id)
      +delete(id)
    }
    class SettingsService {
      +load()
      +update(patch)
    }
    class ProgressService {
      +exerciseSeries(id, period)
      +weeklySeries(period)
      +contributingWorkouts(point)
    }
    class InputValidator {
      +validateDate(date, timezone)
      +validateTypedSet(input, exercise)
      +validateSetTarget(target, exercise)
      +validateName(name)
      +normalizeName(name)
    }
    class UndoToken {
      +UUID workoutId
      +Workout priorSnapshot
      +bool available
    }
    Workout "1" *-- "0..*" WorkoutEntry
