# Public client configuration only. Copy to .env.local and fill in.
# The publishable key is designed to ship in mobile apps; NEVER put a
# service-role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# "true" shows "Continue on this device only" (no account, nothing uploaded).
# Useful for demos without a backend. Keep explicit; defaults to off.
EXPO_PUBLIC_ENABLE_DEVICE_PROFILES=true
