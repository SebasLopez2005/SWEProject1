{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_ENABLE_DEVICE_PROFILES": "true" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ENABLE_DEVICE_PROFILES": "true" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_DEVICE_PROFILES": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
